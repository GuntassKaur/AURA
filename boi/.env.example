# AEGISNET FI — Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://aegis:aegis_secure_2024@localhost:5432/aegisnet
SYNC_DATABASE_URL=postgresql://aegis:aegis_secure_2024@localhost:5432/aegisnet

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your_super_secret_key_here_change_in_production

# AI/ML
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here_optional

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_optional

# ML Config
MODEL_PATH=./models
DATASET_PATH=./datasets
FRAUD_THRESHOLD=0.5
